# IHSG Dashboard — secrets template.
#
# LOCAL use:  copy this file to  .streamlit/secrets.toml  and fill in values.
# CLOUD use:  paste the same keys into
#             Streamlit Community Cloud → your app → ⋮ Manage app → Settings → Secrets.
#
# NEVER commit the real .streamlit/secrets.toml — it is gitignored on purpose.

# ---------------------------------------------------------------------------
# App password (REQUIRED on a public host).
# Locks the whole dashboard behind one shared password. Leave it UNSET locally
# to keep the app open with no login.
# ---------------------------------------------------------------------------
APP_PASSWORD = "choose-a-strong-password"

# ---------------------------------------------------------------------------
# AI research narrative (OPTIONAL — Decision Helper / Daily Trading coach note).
# Free Gemini key, no credit card: https://aistudio.google.com/apikey
# Without it, those pages fall back to the built-in deterministic write-up.
# ---------------------------------------------------------------------------
GEMINI_API_KEY = "your-gemini-api-key"

# ---------------------------------------------------------------------------
# Realtime quotes via iTick (OPTIONAL). The default live provider is Yahoo,
# which needs NO key. Only set these if you switch config.yaml live.provider
# to "itick". Get a token at https://itick.org
# ---------------------------------------------------------------------------
# ITICK_TOKEN = "your-itick-token"
# ITICK_HOST  = "api.itick.org"
